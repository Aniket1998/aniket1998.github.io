{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview website",
      "type": "process",
      "command": "${workspaceFolder}/scripts/preview.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "instanceLimit": 1 },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Generating\\.\\.\\.",
          "endsPattern": "^.*Server running\\.\\.\\."
        }
      }
    },
    {
      "label": "Build website",
      "type": "process",
      "command": "${workspaceFolder}/scripts/preview.sh",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
